

# ---- Database & Authentication -------------------------------
# MongoDB connection URI (e.g. Atlas cluster or local mongod)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Kylo?retryWrites=true&w=majority
# Google OAuth 2.0 for user sign-up and sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GOOGLE_AIStudio_API_KEY=

VERTEX_API_KEY=
JARVIS__GOOGLE__VERTEX_PROJECT=

JARVIS__GOOGLE__VERTEX_LOCATION=
JARVIS__GOOGLE__SERVICE_ACCOUNT_PATH=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
CODEX_OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

NVIDIA_API_KEY=

GROQ_API_KEY=
DEEPGRAM_API_KEY=


CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Grok Voice TTS reuses GROK_API_KEY (see above).
# Google Cloud TTS (Neural2) — path to a service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini Flash TTS via Vertex AI (bypasses the AI-Studio preview RPD cap):
# set your GCP project id here; SA path is in jarvis.toml [tts].service_account_path.
JARVIS__TTS__VERTEX_PROJECT=


# ---- Web search (optional prepaid hop) ------------------------
# Live web search works with no key (DuckDuckGo). To use a prepaid
# Google hop instead of Tavily / Serper / Brave, one Apifare token:
# https://apifare.com/start  (env name APIPAY_TOKEN is the official one)
APIPAY_TOKEN=


# ---- Weather --------------------------------------------------
# https://openweathermap.org/api
OPENWEATHER_API_KEY=


# ---- Channels & telephony -------------------------------------
# Telegram bot. https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Discord bot. https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Twilio — call Jarvis on a phone number. Auth token only; Account SID +
# number live in jarvis.toml [integrations.twilio]. https://console.twilio.com
TWILIO_AUTH_TOKEN=


# ---- Admin helper ---------------------------------------------
# HMAC key for Phase-5 admin ops (winget/services/registry/firewall).
# Auto-generated on first helper start — you normally do NOT set this by hand.
JARVIS_ADMIN_HMAC=


# ---- App settings ---------------------------------------------
APP_ENV=development
LOG_LEVEL=info
